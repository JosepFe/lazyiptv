class Pane:
    def __init__(self, title=""):
        self.title = title
        self._items = []     # lista de (id, etiqueta)
        self._norms = None   # etiquetas normalizadas, calculadas al filtrar por primera vez
        self._filter = ""
        self._visible = None
        self.cursor = 0
        self.top = 0

    @property
    def items(self):
        return self._items

    def set_items(self, items, keep=None):
        self._items, self._norms, self._visible = items, None, None
        self.reset()
        if keep is not None:
            self.select(keep)

    @property
    def filter(self):
        return self._filter

    @filter.setter
    def filter(self, value):
        self._filter, self._visible = value, None

    def visible(self):
        if self._visible is None:
            if not self._filter:
                self._visible = self._items
            else:
                if self._norms is None:
                    self._norms = [normalize(label) for _, label in self._items]
                words = normalize(self._filter).split()
                self._visible = [it for it, n in zip(self._items, self._norms) if all(w in n for w in words)]
        return self._visible

    def selected(self):
        vis = self.visible()
        return vis[self.cursor] if vis and self.cursor < len(vis) else None

    def select(self, item_id):
        for i, (iid, _) in enumerate(self.visible()):
            if iid == item_id:
                self.cursor = i
                return True
        return False

    def move(self, delta):
        n = len(self.visible())
        self.cursor = max(0, min(n - 1, self.cursor + delta)) if n else 0

    def reset(self):
        self.cursor = self.top = 0


class SearchPane(Pane):
    """Como Pane, pero ordena los resultados: primero los títulos que empiezan por lo buscado."""

    def __init__(self, title=""):
        super().__init__(title)
        self.names = {}  # id → nombre normalizado (sin etiqueta ni grupo)

    def visible(self):
        if self._visible is None:
            vis = super().visible()
            query = normalize(self._filter).strip()
            if query:
                def rank(item):
                    # 0: empieza por lo buscado · 1: alguna palabra empieza por ello · 2: lo contiene;
                    # a igualdad, el título más corto (el más parecido a lo buscado)
                    name = self.names.get(item[0], "")
                    level = 0 if name.startswith(query) else 1 if f" {query}" in f" {name}" else 2
                    return level, len(name)
                vis = sorted(vis, key=rank)
            self._visible = vis
        return self._visible


class Tab:
    def __init__(self, kind):
        self.kind = kind
        self.groups = Pane("Grupos")
        self.items = Pane(TAB_NAMES[kind])
        self.episodes = Pane("Episodios")
        self.focus = "groups"
        self.sort = 0
        self.open_series = None  # id de la serie cuyos episodios están cargados

    def pane(self, name=None):
        return getattr(self, name or self.focus)


class App:
    def __init__(self, screen, cfg, account):
        self.screen = screen
        self.cfg = cfg
        self.status = ""
        self.playing = ""
        self.typing = False
        self.show_info = False
        self.mode = "browse"  # o "search"
        self.search = SearchPane("Buscar en todo")
        self.open_account(account)

    # ----- datos -----
    def open_account(self, account):
        self.account = account
        self.source = make_source(account)
        adir = account_dir(account)
        self.favs_file = os.path.join(adir, "favorites.json")
        self.groups_file = os.path.join(adir, "groups.json")
        self.history_file = os.path.join(adir, "history.json")
        self.favs = load_per_kind(self.favs_file)
        self.pinned = load_per_kind(self.groups_file)  # ids de grupo, en el orden en que se fijaron
        self.history = load_json(self.history_file, [])
        self.data = {kind: None for kind in KINDS}
        self.episode_cache = {}  # series_id → episodios
        self.entries = {}        # id → entrada de historial (para Recientes / Seguir viendo)
        self.tabs = {kind: Tab(kind) for kind in KINDS}
        self.tab = self.tabs["live"]
        self.mode = "browse"
        self.ensure_loaded("live")

    def ensure_loaded(self, kind, force=False):
        if self.data[kind] is not None and not force:
            return True
        what = {"live": "canales", "movie": "películas", "series": "series"}[kind]
        self.message(f"Cargando {what} de {self.account['name']}…")
        try:
            raw = self.source.load(kind, force=force)
        except Exception as exc:  # red caída, credenciales mal, etc.
            self.status = f"Error cargando {what}: {exc}"
            raw = {"categories": [], "items": []}
            ok = False
        else:
            self.status = f"{len(raw['items'])} {what} en {len(raw['categories'])} grupos"
            ok = True
        by_cat = {}
        for item in raw["items"]:
            by_cat.setdefault(item["cat"], []).append(item)
        self.data[kind] = {"categories": raw["categories"], "items": raw["items"],
                           "by_id": {it["id"]: it for it in raw["items"]}, "by_cat": by_cat}
        tab = self.tabs[kind]
        keep = tab.groups.selected()
        self.build_groups(tab, keep[0] if keep else None)
        return ok

    def build_groups(self, tab, keep=None):
        kind, data = tab.kind, self.data[tab.kind]
        labels = {c["id"]: f"{c['name']} ({len(data['by_cat'].get(c['id'], []))})" for c in data["categories"]}
        pinned = [gid for gid in self.pinned[kind] if gid in labels]
        items = [(FAVS_ID, "★ Favoritos")]
        if kind != "live":
            items.append((CONT_ID, "▶ Seguir viendo"))
        items.append((RECENT_ID, "◷ Recientes"))
        items += [(gid, labels[gid]) for gid in pinned]
        items.append((ALL_ID, f"{ALL_NAMES[kind]} ({len(data['items'])})"))
        items += [(gid, label) for gid, label in labels.items() if gid not in pinned]
        tab.groups.set_items(items, keep=keep)
        self.fill_items(tab)

    def item_label(self, kind, item):
        label = item["name"]
        if item.get("rating"):
            label += f"  · {item['rating']:.1f}"
        return label

    def sort_items(self, tab, items):
        mode = SORTS[tab.kind][tab.sort]
        if mode == "nombre":
            return sorted(items, key=lambda it: normalize(it["name"]))
        if mode == "año":
            return sorted(items, key=lambda it: it.get("year") or "", reverse=True)
        if mode == "nota":
            return sorted(items, key=lambda it: it.get("rating") or 0, reverse=True)
        if mode in ("añadidas", "actualizadas"):
            return sorted(items, key=lambda it: it.get("added") or 0, reverse=True)
        return items

    def history_items(self, kind, only_resumable):
        pairs = []
        for entry in self.history:
            if entry["kind"] != kind:
                continue
            label = entry["name"]
            if only_resumable:
                pos = watch_position(self.entry_url(entry))
                if not pos:
                    continue
                label += f"  ⏵ {fmt_time(pos)}"
            self.entries[entry["id"]] = entry
            pairs.append((entry["id"], label))
        return pairs

    def fill_items(self, tab, keep=None):
        group = tab.groups.selected()
        kind, data = tab.kind, self.data[tab.kind]
        title = TAB_NAMES[kind]
        pairs = []
        if group:
            gid, title = group
            if gid == FAVS_ID:
                items = [data["by_id"][i] for i in self.favs[kind] if i in data["by_id"]]
                pairs = [(it["id"], self.item_label(kind, it)) for it in self.sort_items(tab, items)]
            elif gid == RECENT_ID:
                pairs = self.history_items(kind, only_resumable=False)
            elif gid == CONT_ID:
                pairs = self.history_items(kind, only_resumable=True)
            else:
                items = data["items"] if gid == ALL_ID else data["by_cat"].get(gid, [])
                pairs = [(it["id"], self.item_label(kind, it)) for it in self.sort_items(tab, items)]
            if gid not in (RECENT_ID, CONT_ID) and SORTS[kind][tab.sort] != "proveedor":
                title += f" · orden: {SORTS[kind][tab.sort]}"
        tab.items.title = title
        tab.items.filter = ""
        tab.items.set_items(pairs, keep=keep)

    def find(self, kind, item_id):
        data = self.data[kind]
        if data and item_id in data["by_id"]:
            return data["by_id"][item_id]
        return self.entries.get(item_id)

    def entry_url(self, entry):
        """URL de una entrada de historial (no se guardan URLs con credenciales en el historial)."""
        if self.account["type"] != "xtream":
            return entry.get("eid") or entry["id"]
        if entry.get("eid"):
            return self.source.url("episode", entry["eid"], entry.get("ext"))
        return self.source.url(entry["kind"], entry["id"], entry.get("ext"))

    def remember(self, entry):
        entry = {**entry, "t": int(time.time())}
        self.history = [entry] + [h for h in self.history if h["id"] != entry["id"]]
        del self.history[HISTORY_MAX:]
        save_json(self.history_file, self.history)

    def load_episodes(self, series_id):
        if series_id not in self.episode_cache:
            self.message("Cargando episodios…")
            try:
                self.episode_cache[series_id] = self.source.episodes(series_id)
            except Exception as exc:
                self.status = f"Error cargando episodios: {exc}"
                return []
        return self.episode_cache[series_id]

    # ----- dibujo -----
    def message(self, text):
        h, w = self.screen.getmaxyx()
        self.screen.erase()
        try:
            self.screen.addstr(h // 2, max(0, (w - len(text)) // 2), clip(text, w - 1))
        except curses.error:
            pass
        self.screen.refresh()

    def border_attr(self, active):
        return curses.color_pair(1) | curses.A_BOLD if active else curses.color_pair(3)

    def draw_box(self, y, x, h, w, title, active):
        win = self.screen.derwin(h, w, y, x)
        attr = self.border_attr(active)
        win.attrset(attr)
        win.box()
        try:
            win.addstr(0, 2, clip(f" {title} ", w - 4).rstrip(), attr)
        except curses.error:
            pass
        return win

    def draw_pane(self, pane, y, x, h, w, title, active, stars=(), empty="(vacío)"):
        if self.typing and active:
            title += f" / {pane.filter}▏"
        elif pane.filter:
            title += f" / {pane.filter}"
        win = self.draw_box(y, x, h, w, title, active)
        vis = pane.visible()
        rows = h - 2
        if pane.cursor < pane.top:
            pane.top = pane.cursor
        elif pane.cursor >= pane.top + rows:
            pane.top = pane.cursor - rows + 1
        for i, (iid, label) in enumerate(vis[pane.top:pane.top + rows]):
            idx = pane.top + i
            mark = "★ " if iid in stars else "  "
            attr = curses.A_NORMAL
            if idx == pane.cursor:
                attr = curses.color_pair(2) | curses.A_BOLD if active else curses.A_REVERSE
            try:
                win.addstr(1 + i, 1, clip(mark + label, w - 2), attr)
            except curses.error:
                pass
        if not vis:
            try:
                win.addstr(1, 2, clip(empty, w - 4), curses.A_DIM)
            except curses.error:
                pass
        count = f" {pane.cursor + 1 if vis else 0}/{len(vis)} "
        try:
            win.addstr(h - 1, max(1, w - len(count) - 2), count, self.border_attr(active))
        except curses.error:
            pass

    def info_lines(self, kind, item, width):
        """Líneas (texto, atributo) de la ficha de una película o serie."""
        if not item:
            return []
        lines = [(item["name"], curses.A_BOLD)]
        meta = [item.get("year"), item.get("genre")]
        if item.get("rating"):
            meta.append(f"★ {item['rating']:.1f}")
        if item.get("duration"):
            meta.append(f"{item['duration'] // 60}h {item['duration'] % 60:02}m" if item["duration"] >= 60
                        else f"{item['duration']} min")
        meta = " · ".join(m for m in meta if m)
        if meta:
            lines += [(line, curses.color_pair(1)) for line in wrap(meta, width)]
        if item.get("director"):
            lines += [(line, curses.A_NORMAL) for line in wrap(f"Dirección: {item['director']}", width)]
        if item.get("cast"):
            lines += [(line, curses.A_NORMAL) for line in wrap(f"Reparto: {item['cast']}", width)[:3]]
        if item.get("added"):
            word = "Añadida" if kind == "movie" else "Actualizada"
            lines.append((f"{word} el {time.strftime('%d/%m/%Y', time.localtime(item['added']))}", curses.A_DIM))
        if item.get("plot"):
            lines.append(("", 0))
            lines += [(line, curses.A_NORMAL) for line in wrap(item["plot"], width)]
        if kind == "series" and not item.get("url") and not item.get("eid"):
            lines += [("", 0), ("Enter: ver temporadas y episodios", curses.A_DIM)]
        return lines

    def draw_info(self, kind, item, y, x, h, w):
        win = self.draw_box(y, x, h, w, "Ficha", False)
        for i, (text, attr) in enumerate(self.info_lines(kind, item, w - 4)[:h - 2]):
            try:
                win.addstr(1 + i, 2, clip(text, w - 4), attr)
            except curses.error:
                pass

    def draw_tabs(self, w):
        x = 1
        for i, kind in enumerate(KINDS):
            label = f" {i + 1} {TAB_NAMES[kind]} "
            current = self.mode == "browse" and self.tab.kind == kind
            attr = curses.color_pair(2) | curses.A_BOLD if current else curses.A_DIM
            try:
                self.screen.addstr(0, x, label, attr)
            except curses.error:
                pass
            x += len(label) + 1
        search = " s Buscar en todo "
        attr = curses.color_pair(2) | curses.A_BOLD if self.mode == "search" else curses.A_DIM
        right = f"{self.account['name']} "
        try:
            self.screen.addstr(0, x + 1, search, attr)
            self.screen.addstr(0, max(x + len(search) + 3, w - len(right) - 1), right, curses.color_pair(1))
        except curses.error:
            pass

    def selected_item(self):
        """(tipo, elemento) bajo el cursor, para la ficha."""
        if self.mode == "search":
            sel = self.search.selected()
            if not sel:
                return None, None
            kind, iid = sel[0].split("|", 1)
            return kind, self.find(kind, iid)
        tab = self.tab
        sel = tab.items.selected()
        return tab.kind, (self.find(tab.kind, sel[0]) if sel else None)

    def draw(self):
        self.screen.erase()
        h, w = self.screen.getmaxyx()
        if h < 10 or w < 50:
            self.message("Ventana demasiado pequeña")
            return
        self.draw_tabs(w)
        top, body = 1, h - 3
        wide = w >= WIDE
        if self.mode == "search":
            self.draw_search(top, body, w, wide)
        else:
            self.draw_browse(top, body, w, wide)
        playing = f"▶ {self.playing}   " if self.playing else ""
        try:
            self.screen.addstr(h - 2, 1, clip(playing + self.status, w - 2), curses.color_pair(1))
            self.screen.addstr(h - 1, 1, clip(self.hint(), w - 2), curses.A_DIM)
        except curses.error:
            pass
        self.screen.refresh()

    def draw_browse(self, top, body, w, wide):
        tab = self.tab
        kind = tab.kind
        groups_title = f"{TAB_NAMES[kind]} · Grupos"
        stars = set(self.favs[kind])
        if kind == "live":
            left = max(24, w // 3)
            self.draw_pane(tab.groups, top, 0, body, left, groups_title, tab.focus == "groups", set(self.pinned[kind]))
            self.draw_pane(tab.items, top, left, body, w - left, tab.items.title, tab.focus == "items", stars)
            return
        left = max(22, w // 4)
        self.draw_pane(tab.groups, top, 0, body, left, groups_title, tab.focus == "groups", set(self.pinned[kind]))
        sel = tab.items.selected()
        showing_episodes = kind == "series" and tab.open_series and sel and sel[0] == tab.open_series
        if wide:
            mid = max(30, (w - left) * 5 // 11)
            self.draw_pane(tab.items, top, left, body, mid, tab.items.title, tab.focus == "items", stars)
            x, rw = left + mid, w - left - mid
        else:
            x, rw = left, w - left
            if not (tab.focus == "episodes" or self.show_info):
                self.draw_pane(tab.items, top, left, body, rw, tab.items.title, tab.focus == "items", stars)
                return
        if showing_episodes:
            name = self.find(kind, tab.open_series)["name"]
            self.draw_pane(tab.episodes, top, x, body, rw, f"{name} · Episodios", tab.focus == "episodes",
                           empty="(sin episodios)")
        else:
            self.draw_info(*self.selected_item(), top, x, body, rw)

    def draw_search(self, top, body, w, wide):
        rw = w * 2 // 5 if wide or self.show_info else 0
        empty = "Escribe al menos 2 letras" if len(self.search.filter) < 2 else "Sin resultados"
        stars = {f"{k}|{i}" for k in KINDS for i in self.favs[k]}
        if len(self.search.filter) < 2:
            hold = self.search._visible
            self.search._visible = []
            self.draw_pane(self.search, top, 0, body, w - rw, "Buscar en todo", True, stars, empty)
            self.search._visible = hold
        else:
            self.draw_pane(self.search, top, 0, body, w - rw, "Buscar en todo", True, stars, empty)
        if rw:
            self.draw_info(*self.selected_item(), top, w - rw, body, rw)

    def hint(self):
        if self.typing:
            return "Escribe para filtrar · Enter terminar · Esc borrar"
        if self.mode == "search":
            return "Enter abrir · / escribir · f favorito · Esc volver · q salir"
        common = "f favorito · o orden · s buscar · a lista · x parar · ? ayuda · q salir"
        if self.tab.focus == "episodes":
            return "Enter reproducir (y siguientes) · h volver · " + common
        return "1-3 pestañas · Enter abrir · / filtrar · " + common

    def show_help(self):
        self.screen.erase()
        for i, line in enumerate(HELP):
            try:
                self.screen.addstr(1 + i, 2, line, curses.A_BOLD if i == 0 else curses.A_NORMAL)
            except curses.error:
                pass
        self.screen.refresh()
        self.screen.get_wch()

    # ----- acciones -----
    def switch_tab(self, kind):
        self.mode = "browse"
        self.tab = self.tabs[kind]
        self.ensure_loaded(kind)
        # "Seguir viendo" y "Recientes" cambian al ver cosas: refrescar al volver
        group = self.tab.groups.selected()
        if group and group[0] in (CONT_ID, RECENT_ID, FAVS_ID):
            sel = self.tab.items.selected()
            self.fill_items(self.tab, keep=sel[0] if sel else None)

    def open_series(self, series_id):
        tab = self.tabs["series"]
        episodes = self.load_episodes(series_id)
        name = self.find("series", series_id)["name"]
        labels = []
        for ep in episodes:
            # "Serie (2008) - S02E01 - Título" → "Título"; sin título → "Episodio 1"
            title = re.sub(r"^.*\b[ST]\d+\s*E\d+\b\s*[-–:]?\s*", "", ep["title"], flags=re.I).strip()
            title = title or f"Episodio {ep['num']}"
            label = f"T{ep['season']} · E{ep['num']:02} · {title}"
            pos = watch_position(self.source.url("episode", ep["id"], ep["ext"]))
            if pos:
                label += f"  ⏵ {fmt_time(pos)}"
            labels.append((ep["id"], label))
        tab.open_series = series_id
        tab.episodes.filter = ""
        tab.episodes.set_items(labels)
        # empezar por el último episodio a medias, si lo hay
        for entry in self.history:
            if entry.get("sid") == series_id and tab.episodes.select(entry["eid"]):
                break
        tab.focus = "episodes"
        self.status = f"{name}: {len(episodes)} episodios"

    def play_episode(self, series_id, episode_id):
        episodes = self.load_episodes(series_id)
        idx = next((i for i, ep in enumerate(episodes) if ep["id"] == episode_id), None)
        if idx is None:
            self.status = "No encuentro ese episodio."
            return
        name = self.find("series", series_id)
        name = name["name"].split(" · ")[0] if name else ""
        queue = []
        for ep in episodes[idx:idx + NEXT_EPISODES_MAX]:
            queue.append({"url": self.source.url("episode", ep["id"], ep["ext"]),
                          "title": f"{name} · T{ep['season']}E{ep['num']:02}", "live": False})
        ep = episodes[idx]
        self.remember({"kind": "series", "id": f"ep|{series_id}|{ep['id']}", "sid": series_id, "eid": ep["id"],
                       "ext": ep["ext"], "name": f"{name} · T{ep['season']}E{ep['num']:02}"})
        self.start(queue)

    def start(self, queue):
        error = play(queue)
        if error:
            self.status = error
        else:
            self.playing = queue[0]["title"]
            more = f" (+{len(queue) - 1} en cola)" if len(queue) > 1 else ""
            self.status = f"Abriendo en mpv…{more}"

    def activate(self, kind, item_id):
        """Enter sobre un elemento: reproducir, o abrir los episodios de una serie."""
        item = self.find(kind, item_id)
        if not item:
            return
        if item.get("eid"):  # episodio guardado en Recientes / Seguir viendo
            if self.account["type"] == "xtream":
                self.play_episode(item["sid"], item["eid"])
            else:
                self.remember(item)
                self.start([{"url": self.entry_url(item), "title": item["name"], "live": False}])
            return
        if kind == "series" and not item.get("url"):
            self.open_series(item_id)
            return
        url = item.get("url") or self.source.url(kind, item_id, item.get("ext"))
        self.remember({"kind": kind, "id": item_id, "name": item["name"], "ext": item.get("ext")})
        self.start([{"url": url, "title": item["name"], "live": kind == "live"}])

    def enter(self):
        if self.mode == "search":
            sel = self.search.selected()
            if not sel:
                return
            kind, iid = sel[0].split("|", 1)
            item = self.find(kind, iid)
            if kind == "series" and item and not item.get("url"):
                self.jump_to_series(iid)
            else:
                self.activate(kind, iid)
            return
        tab = self.tab
        if tab.focus == "groups":
            tab.focus = "items"
        elif tab.focus == "items":
            sel = tab.items.selected()
            if sel:
                self.activate(tab.kind, sel[0])
        elif tab.focus == "episodes":
            sel = tab.episodes.selected()
            if sel:
                self.play_episode(tab.open_series, sel[0])

    def jump_to_series(self, series_id):
        """Desde la búsqueda: ir a la pestaña Series con esa serie abierta."""
        self.switch_tab("series")
        tab = self.tab
        tab.groups.filter = ""
        tab.groups.select(ALL_ID)
        self.fill_items(tab, keep=series_id)
        self.open_series(series_id)

    def start_search(self):
        for kind in KINDS:
            self.ensure_loaded(kind)
        items, names = [], {}
        tags = {"live": "[TV]", "movie": "[PELI]", "series": "[SERIE]"}
        for kind in KINDS:
            data = self.data[kind]
            cats = {c["id"]: c["name"] for c in data["categories"]}
            for it in data["items"]:
                sid = f"{kind}|{it['id']}"
                items.append((sid, f"{tags[kind]:8}{self.item_label(kind, it)}   — {cats.get(it['cat'], '')}"))
                # sin "(LAT)", "(1972)"…: para ordenar solo cuenta el título
                names[sid] = " ".join(normalize(re.sub(r"\(.*?\)|\[.*?\]", " ", it["name"])).split())
        query = self.search.filter
        self.search.names = names
        self.search.set_items(items)
        self.search.filter = query
        self.mode = "search"
        self.typing = True
        self.status = "Busca por nombre; pon varias palabras para afinar"

    def toggle_fav(self):
        if self.mode == "search":
            sel = self.search.selected()
            if sel:
                kind, iid = sel[0].split("|", 1)
                self.toggle_item_fav(kind, iid)
            return
        tab = self.tab
        if tab.focus == "groups":
            self.toggle_pin(tab)
        elif tab.focus == "items":
            sel = tab.items.selected()
            if sel:
                item = self.find(tab.kind, sel[0])
                if item and item.get("eid"):
                    self.toggle_item_fav("series", item["sid"])
                else:
                    self.toggle_item_fav(tab.kind, sel[0])
        elif tab.focus == "episodes":
            self.toggle_item_fav("series", tab.open_series)

    def toggle_item_fav(self, kind, item_id):
        item = self.find(kind, item_id)
        name = item["name"] if item else item_id
        if item_id in self.favs[kind]:
            self.favs[kind].remove(item_id)
            self.status = f"Quitado de favoritos: {name}"
        else:
            self.favs[kind].append(item_id)
            self.status = f"Añadido a favoritos: {name}"
        save_json(self.favs_file, self.favs)
        tab = self.tabs[kind]
        group = tab.groups.selected()
        if self.mode == "browse" and group and group[0] == FAVS_ID and tab is self.tab:
            sel = tab.items.selected()
            self.fill_items(tab, keep=sel[0] if sel else None)

    def toggle_pin(self, tab):
        item = tab.groups.selected()
        if not item or item[0] in SPECIAL:
            return
        pinned = self.pinned[tab.kind]
        if item[0] in pinned:
            pinned.remove(item[0])
            self.status = f"Grupo soltado: {item[1]}"
        else:
            pinned.append(item[0])
            self.status = f"Grupo fijado arriba: {item[1]}"
        save_json(self.groups_file, self.pinned)
        self.build_groups(tab, keep=item[0])

    def cycle_sort(self):
        tab = self.tab
        tab.sort = (tab.sort + 1) % len(SORTS[tab.kind])
        sel = tab.items.selected()
        self.fill_items(tab, keep=sel[0] if sel else None)
        self.status = f"Orden: {SORTS[tab.kind][tab.sort]}"

    def switch_account(self):
        accounts = self.cfg["accounts"]
        current = accounts.index(self.account) if self.account in accounts else 0
        choice = choose_account(self.screen, self.cfg, current)
        if choice is not None and choice is not self.account:
            self.open_account(choice)

    def handle_typing(self, key, pane, on_change):
        if key in ("\n", "\r", curses.KEY_ENTER):
            self.typing = False
        elif key == "\x1b":
            self.typing = False
            pane.filter = ""
        elif key in (curses.KEY_BACKSPACE, "\x7f", "\b", "\x08"):
            pane.filter = pane.filter[:-1]
        elif key == "\x15":  # Ctrl+U
            pane.filter = ""
        elif key in (curses.KEY_UP, curses.KEY_DOWN):
            pane.move(-1 if key == curses.KEY_UP else 1)
            return
        elif isinstance(key, str) and key.isprintable():
            pane.filter += key
        else:
            return
        pane.reset()
        on_change()

    def focus_order(self):
        tab = self.tab
        order = ["groups", "items"]
        sel = tab.items.selected()
        if tab.kind == "series" and tab.open_series and sel and sel[0] == tab.open_series:
            order.append("episodes")
        return order

    def run(self):
        while True:
            self.draw()
            key = self.screen.get_wch()
            if key == curses.KEY_RESIZE:
                continue
            if self.mode == "search":
                self.run_search_key(key)
            else:
                if self.run_browse_key(key) == "quit":
                    return
            if key in ("q", "Q") and not self.typing and self.mode == "search":
                return

    def run_search_key(self, key):
        pane = self.search
        if self.typing:
            self.handle_typing(key, pane, lambda: None)
            return
        page = max(1, self.screen.getmaxyx()[0] - 5)
        if key == "\x1b":
            self.mode = "browse"
            self.status = ""
        elif key in ("/", "s"):
            self.typing = True
        elif key in ("j", curses.KEY_DOWN):
            pane.move(1)
        elif key in ("k", curses.KEY_UP):
            pane.move(-1)
        elif key == curses.KEY_NPAGE:
            pane.move(page)
        elif key == curses.KEY_PPAGE:
            pane.move(-page)
        elif key in ("g", curses.KEY_HOME):
            pane.move(-10**9)
        elif key in ("G", curses.KEY_END):
            pane.move(10**9)
        elif key in ("\n", "\r", curses.KEY_ENTER):
            self.enter()
        elif key == "f":
            self.toggle_fav()
        elif key == "i":
            self.show_info = not self.show_info
        elif key == "x":
            self.status = "Reproductor parado" if stop() else "No hay reproductor abierto"
            self.playing = ""
        elif key in ("1", "2", "3"):
            self.switch_tab(KINDS[int(key) - 1])

    def run_browse_key(self, key):
        tab = self.tab
        pane = tab.pane()
        if self.typing:
            on_change = (lambda: self.fill_items(tab)) if tab.focus == "groups" else (lambda: None)
            self.handle_typing(key, pane, on_change)
            return None
        page = max(1, self.screen.getmaxyx()[0] - 5)
        before = tab.groups.selected()
        order = self.focus_order()
        if key in ("q", "Q"):
            return "quit"
        elif key in ("1", "2", "3"):
            self.switch_tab(KINDS[int(key) - 1])
            return None
        elif key in ("j", curses.KEY_DOWN):
            pane.move(1)
        elif key in ("k", curses.KEY_UP):
            pane.move(-1)
        elif key == curses.KEY_NPAGE:
            pane.move(page)
        elif key == curses.KEY_PPAGE:
            pane.move(-page)
        elif key in ("g", curses.KEY_HOME):
            pane.move(-10**9)
        elif key in ("G", curses.KEY_END):
            pane.move(10**9)
        elif key in ("l", curses.KEY_RIGHT):
            if tab.focus == "groups":
                tab.focus = "items"
            elif tab.focus == "items" and tab.kind == "series":
                self.enter()
        elif key in ("h", curses.KEY_LEFT):
            tab.focus = {"episodes": "items", "items": "groups"}.get(tab.focus, "groups")
        elif key == "\t":
            tab.focus = order[(order.index(tab.focus) + 1) % len(order)] if tab.focus in order else "groups"
        elif key in ("\n", "\r", curses.KEY_ENTER):
            self.enter()
        elif key == "/":
            self.typing = True
        elif key == "s":
            self.start_search()
            return None
        elif key == "\x1b":
            pane.filter = ""
            pane.reset()
            if tab.focus == "groups":
                self.fill_items(tab)
        elif key == "f":
            self.toggle_fav()
        elif key == "o":
            self.cycle_sort()
        elif key == "i":
            self.show_info = not self.show_info
        elif key == "a":
            self.switch_account()
            return None
        elif key == "x":
            self.status = "Reproductor parado" if stop() else "No hay reproductor abierto"
            self.playing = ""
        elif key == "r":
            self.ensure_loaded(tab.kind, force=True)
            return None
        elif key == "?":
            self.show_help()
        if tab.groups.selected() != before:
            self.fill_items(tab)
        return None


# ---------- selector de listas y asistente dentro de la interfaz ----------

ADD = "__add__"


def pick_account(screen, accounts, current=0):
    """Pantalla para elegir lista. Devuelve la cuenta, ADD para añadir una, o None si se cancela."""
    options = accounts + [ADD]
    cursor = current
    while True:
        screen.erase()
        h, w = screen.getmaxyx()
        try:
            screen.addstr(1, 2, "¿Qué lista abro?", curses.color_pair(1) | curses.A_BOLD)
            for i, a in enumerate(options[: max(0, h - 5)]):
                if a is ADD:
                    label = "+ Añadir lista nueva"
                else:
                    label = f"{a['name']}  ({'Xtream' if a['type'] == 'xtream' else 'M3U'})"
                attr = curses.color_pair(2) | curses.A_BOLD if i == cursor else curses.A_NORMAL
                screen.addstr(3 + i, 4, clip(label, w - 8), attr)
            screen.addstr(h - 1, 2, clip("Enter elegir · j/k moverse · Esc/q cancelar", w - 4), curses.A_DIM)
        except curses.error:
            pass
        screen.refresh()
        key = screen.get_wch()
        if key in ("j", curses.KEY_DOWN):
            cursor = min(len(options) - 1, cursor + 1)
        elif key in ("k", curses.KEY_UP):
            cursor = max(0, cursor - 1)
        elif key in ("g", curses.KEY_HOME):
            cursor = 0
        elif key in ("G", curses.KEY_END):
            cursor = len(options) - 1
        elif key in ("\n", "\r", curses.KEY_ENTER):
            return options[cursor]
        elif key in ("q", "\x1b"):
            return None


def show_lines(screen, lines, wait=True):
    """Pantalla de aviso. Con wait=True espera una tecla."""
    screen.erase()
    h, w = screen.getmaxyx()
    try:
        screen.addstr(1, 2, "Añadir lista", curses.color_pair(1) | curses.A_BOLD)
        for i, line in enumerate(lines):
            screen.addstr(3 + i, 2, clip(line, w - 4))
        if wait:
            screen.addstr(h - 1, 2, clip("Pulsa cualquier tecla para seguir", w - 4), curses.A_DIM)
    except curses.error:
        pass
    screen.refresh()
    if wait:
        screen.get_wch()


def prompt(screen, label, secret=False, hint=""):
    """Campo de texto. Devuelve lo escrito, o None si se pulsa Esc."""
    text = ""
    while True:
        screen.erase()
        h, w = screen.getmaxyx()
        shown = ("•" * len(text)) if secret else text
        room = w - 8
        if len(shown) > room:  # enlaces largos: se ve el final, que es lo que se está escribiendo
            shown = "…" + shown[-(room - 1):]
        try:
            screen.addstr(1, 2, "Añadir lista", curses.color_pair(1) | curses.A_BOLD)
            row = 3
            if hint:
                screen.addstr(row, 2, clip(hint, w - 4), curses.A_DIM)
                row += 2
            screen.addstr(row, 2, clip(label, w - 4), curses.A_BOLD)
            screen.addstr(row + 1, 2, "> " + shown + "▏", curses.color_pair(1))
            screen.addstr(h - 1, 2, clip("Enter aceptar · Esc cancelar · se puede pegar con Ctrl+Shift+V", w - 4),
                          curses.A_DIM)
        except curses.error:
            pass
        screen.refresh()
        key = screen.get_wch()
        if key in ("\n", "\r", curses.KEY_ENTER):
            return text.strip()
        if key == "\x1b":
            return None
        if key in (curses.KEY_BACKSPACE, "\x7f", "\b", "\x08"):
            text = text[:-1]
        elif key == "\x15":  # Ctrl+U: borrar todo
            text = ""
        elif isinstance(key, str) and key.isprintable():
            text += key


def add_account_tui(screen, cfg):
    """Asistente de 'Añadir lista' dentro del programa. Devuelve la cuenta nueva o None."""
    name = prompt(screen, "Nombre de la lista:", hint="Por ejemplo: Casa, Fútbol, Lista de Juan…")
    if name is None:
        return None
    error = name_error(cfg, name)
    if error:
        show_lines(screen, [error])
        return None
    source = prompt(screen, "Enlace o archivo:", hint=SOURCE_HELP + ".")
    if not source:
        return None
    try:
        account = build_account(name, source, lambda label, secret: prompt(screen, label, secret))
    except ValueError as exc:
        show_lines(screen, [str(exc)])
        return None
    if account is None:
        return None
    show_lines(screen, [f"Probando '{name}'…", "", "Si es una lista M3U muy grande, puede tardar un rato."], wait=False)
    try:
        data = test_and_save(cfg, account)
    except Exception as exc:
        show_lines(screen, ["No funciona, no la guardo:", str(exc)])
        return None
    show_lines(screen, [f"Lista '{name}' guardada: {len(data['items'])} canales en {len(data['categories'])} grupos."])
    return account


def choose_account(screen, cfg, current=0):
    """Elegir lista (o añadir una). Devuelve la cuenta a abrir o None."""
    while True:
        if not cfg["accounts"]:
            account = add_account_tui(screen, cfg)
            if account or not cfg["accounts"]:
                return account
            continue
        choice = pick_account(screen, cfg["accounts"], current)
        if choice is not ADD:
            return choice
        account = add_account_tui(screen, cfg)
        if account:
            return account


def main(screen, cfg, account):
    curses.curs_set(0)
    try:
        curses.use_default_colors()
        background = -1
    except curses.error:
        background = curses.COLOR_BLACK
    curses.init_pair(1, curses.COLOR_CYAN, background)
    curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_CYAN)
    curses.init_pair(3, curses.COLOR_WHITE, background)
    if account is None:
        account = choose_account(screen, cfg)
        if account is None:
            return
    App(screen, cfg, account).run()


def cli():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    if args and args[0] == "add":
        add_account_wizard()
        return
    if args and args[0] == "list":
        list_accounts()
        return
    cfg = load_config()
    accounts = cfg["accounts"]
    if args and accounts:
        wanted = slug(" ".join(args))
        matches = [a for a in accounts if slug(a["name"]) == wanted] or \
                  [a for a in accounts if slug(a["name"]).startswith(wanted)]
        if not matches:
            sys.exit(f"No hay ninguna lista '{' '.join(args)}'. Mira las que hay con:  lazyiptv list")
        account = matches[0]
    else:
        account = accounts[0] if len(accounts) == 1 else None
    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    curses.wrapper(main, cfg, account)


if __name__ == "__main__":
    cli()
