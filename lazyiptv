# ---------- fuentes ----------
#
# Todas las fuentes devuelven el mismo formato normalizado:
#   categories: [{"id", "name"}]
#   items:      [{"id", "name", "cat", ...}]   (+ year, rating, plot… en películas y series;
#                                               + "url" si el elemento se reproduce tal cual)

def http_get(url, timeout=60):
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    return urllib.request.urlopen(req, timeout=timeout)


def to_float(value):
    try:
        return float(value)
    except (TypeError, ValueError):
        return 0.0


def to_int(value):
    try:
        return int(float(value))
    except (TypeError, ValueError):
        return 0


def clean(value):
    return str(value).strip() if value not in (None, "") else ""


class Source:
    def __init__(self, account):
        self.account = account
        old = os.path.join(CACHE_DIR, slug(account["name"]) + ".json")  # caché de la versión 1
        if os.path.exists(old):
            os.remove(old)

    def cache_path(self, kind):
        return os.path.join(CACHE_DIR, f"{slug(self.account['name'])}-{kind}.json")

    def load(self, kind, force=False):
        path = self.cache_path(kind)
        if not force:
            data = load_json(path, None)
            if data and data.get("v") == CACHE_VERSION and time.time() - data.get("time", 0) < CACHE_MAX_AGE:
                return data
        categories, items = self.fetch(kind)
        data = {"v": CACHE_VERSION, "time": time.time(), "categories": categories, "items": items}
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False)
        return data

    def fetch(self, kind):
        raise NotImplementedError

    def episodes(self, series_id):
        return []

    def url(self, kind, item_id, ext=None):
        raise NotImplementedError


class XtreamSource(Source):
    ACTIONS = {
        "live": ("get_live_categories", "get_live_streams"),
        "movie": ("get_vod_categories", "get_vod_streams"),
        "series": ("get_series_categories", "get_series"),
    }

    def api(self, **params):
        a = self.account
        query = urllib.parse.urlencode({"username": a["username"], "password": a["password"], **params})
        with http_get(f"{a['server'].rstrip('/')}/player_api.php?{query}", timeout=180) as resp:
            return json.load(resp)

    def fetch(self, kind):
        cat_action, items_action = self.ACTIONS[kind]
        categories = [{"id": str(c["category_id"]), "name": clean(c["category_name"])}
                      for c in self.api(action=cat_action)]
        items = []
        for raw in self.api(action=items_action):
            item = {"id": str(raw.get("series_id") if kind == "series" else raw["stream_id"]),
                    "name": clean(raw.get("name")) or "?", "cat": str(raw.get("category_id"))}
            if kind != "live":
                item.update({
                    "year": clean(raw.get("year")) or clean(raw.get("release_date") or raw.get("releaseDate"))[:4],
                    "rating": to_float(raw.get("rating")),
                    "added": to_int(raw.get("added") if kind == "movie" else raw.get("last_modified")),
                    "genre": clean(raw.get("genre")),
                    "plot": clean(raw.get("plot")),
                    "cast": clean(raw.get("cast")),
                    "director": clean(raw.get("director")),
                    "duration": to_int(raw.get("episode_run_time")),
                })
            if kind == "movie":
                item["ext"] = clean(raw.get("container_extension")) or "mp4"
            items.append(item)
        return categories, items

    def episodes(self, series_id):
        info = self.api(action="get_series_info", series_id=series_id)
        episodes = info.get("episodes") or {}
        if isinstance(episodes, list):  # algunos paneles devuelven una lista de temporadas
            episodes = {str(i + 1): season for i, season in enumerate(episodes)}
        result = []
        for season, eps in episodes.items():
            for ep in eps or []:
                details = ep.get("info") or {}
                if not isinstance(details, dict):
                    details = {}
                result.append({
                    "id": str(ep["id"]), "season": to_int(ep.get("season") or season),
                    "num": to_int(ep.get("episode_num")), "title": clean(ep.get("title")),
                    "ext": clean(ep.get("container_extension")) or "mp4",
                    "plot": clean(details.get("plot")), "duration": clean(details.get("duration")),
                })
        result.sort(key=lambda e: (e["season"], e["num"]))
        return result

    def url(self, kind, item_id, ext=None):
        a = self.account
        base = f"{a['server'].rstrip('/')}"
        path = {"live": "live", "movie": "movie", "episode": "series"}[kind]
        return f"{base}/{path}/{a['username']}/{a['password']}/{item_id}.{ext or 'ts'}"


ATTR_RE = re.compile(r'([\w-]+)="([^"]*)"')


class M3USource(Source):
    """Lista M3U. Películas y series se reconocen por /movie/ y /series/ en la URL (formato Xtream)."""

    def __init__(self, account):
        super().__init__(account)
        self._parsed = None

    def lines(self):
        url = self.account["url"]
        if os.path.exists(url):
            with open(url, encoding="utf-8", errors="replace") as f:
                yield from f
        else:
            with http_get(url, timeout=300) as resp:
                for raw in resp:
                    yield raw.decode("utf-8", errors="replace")

    def parse(self):
        if self._parsed is not None:
            return self._parsed
        groups = {kind: {} for kind in KINDS}
        items = {kind: [] for kind in KINDS}
        info = None
        for line in self.lines():
            line = line.strip()
            if line.startswith("#EXTINF"):
                info = line
            elif line and not line.startswith("#") and info:
                attrs = dict(ATTR_RE.findall(info))
                rest = ATTR_RE.sub("", info)
                name = rest.split(",", 1)[1].strip() if "," in rest else attrs.get("tvg-name", "?")
                kind = "movie" if "/movie/" in line else "series" if "/series/" in line else "live"
                group = attrs.get("group-title") or "Sin grupo"
                cid = groups[kind].setdefault(group, str(len(groups[kind]) + 1))
                # el id es la URL: así los favoritos siguen valiendo aunque la lista cambie de orden
                items[kind].append({"id": line, "name": name or "?", "cat": cid, "url": line})
                info = None
        self._parsed = {kind: ([{"id": cid, "name": g} for g, cid in groups[kind].items()], items[kind])
                        for kind in KINDS}
        return self._parsed

    def fetch(self, kind):
        return self.parse()[kind]

    def url(self, kind, item_id, ext=None):
        return item_id


def make_source(account):
    return XtreamSource(account) if account["type"] == "xtream" else M3USource(account)


# ---------- reproductor ----------

def mpv_request(command, reply=False):
    """Envía un comando al mpv de lazyiptv.

    Devuelve None si no hay mpv escuchando; si reply=True, la respuesta (dict); si no, True.
    """
    payload = (json.dumps({"command": command, "request_id": 1}) + "\n").encode()
    try:
        if WINDOWS:
            with open(MPV_IPC, "r+b", buffering=0) as pipe:
                pipe.write(payload)
                while reply:
                    msg = json.loads(pipe.readline() or b"{}")
                    if msg.get("request_id") == 1 or not msg:
                        return msg
        else:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                sock.settimeout(2)
                sock.connect(MPV_IPC)
                sock.sendall(payload)
                if reply:
                    buf = b""
                    while True:
                        chunk = sock.recv(65536)
                        if not chunk:
                            return {}
                        buf += chunk
                        while b"\n" in buf:
                            line, buf = buf.split(b"\n", 1)
                            msg = json.loads(line)
                            if msg.get("request_id") == 1:
                                return msg
        return True
    except (OSError, ValueError):
        return None


def is_vod(url):
    return bool(url) and ("/movie/" in url or "/series/" in url)


def file_options(entry):
    opts = {"force-media-title": entry["title"]}
    if entry["live"]:
        # en directo no tiene sentido guardar ni reanudar la posición
        opts.update({"stream-lavf-o": LAVF_LIVE, "resume-playback": "no", "save-position-on-quit": "no"})
    else:
        opts["stream-lavf-o"] = LAVF_VOD
    return opts


def play(entries):
    """Reproduce entries[0] y deja el resto en cola. entries: [{"url", "title", "live"}].

    Devuelve un mensaje de error o None.
    """
    os.makedirs(WATCH_LATER_DIR, exist_ok=True)
    current = mpv_request(["get_property", "path"], reply=True)
    if current is None:
        mpv = shutil.which("mpv")
        if not mpv:
            return "No encuentro mpv. Instálalo y asegúrate de que está en el PATH."
        detach = ({"creationflags": subprocess.DETACHED_PROCESS | subprocess.CREATE_NEW_PROCESS_GROUP}
                  if WINDOWS else {"start_new_session": True})
        subprocess.Popen(
            [mpv, "--idle=once", f"--input-ipc-server={MPV_IPC}", f"--user-agent={USER_AGENT}",
             "--cache=yes", "--demuxer-max-bytes=50MiB", "--save-position-on-quit",
             f"--watch-later-dir={WATCH_LATER_DIR}", *MPV_ARGS],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL, **detach,
        )
        for _ in range(100):
            time.sleep(0.05)
            if mpv_request(["get_property", "idle-active"], reply=True) is not None:
                break
        else:
            return "mpv no ha arrancado."
    else:
        # guardar por dónde ibas antes de cambiar, si lo que suena es una película o episodio
        if is_vod(current.get("data")):
            mpv_request(["write-watch-later-config"])
        # por si este mpv lo abrió una versión anterior de lazyiptv
        mpv_request(["set_property", "watch-later-dir", WATCH_LATER_DIR])
        mpv_request(["set_property", "save-position-on-quit", True])
    for i, entry in enumerate(entries):
        mpv_request({"name": "loadfile", "url": entry["url"], "flags": "replace" if i == 0 else "append",
                     "options": file_options(entry)})
    return None


def stop():
    return mpv_request(["quit"]) is not None


def watch_position(url):
    """Segundos guardados por mpv para esta URL (watch later), o None."""
    path = os.path.join(WATCH_LATER_DIR, hashlib.md5(url.encode()).hexdigest().upper())
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                if line.startswith("start="):
                    return to_float(line[6:])
    except OSError:
        pass
    return None


def fmt_time(seconds):
    seconds = int(seconds)
    h, rest = divmod(seconds, 3600)
    return f"{h}:{rest // 60:02}:{rest % 60:02}" if h else f"{rest // 60}:{rest % 60:02}"


# ---------- utilidades de texto ----------

def char_width(ch):
    if unicodedata.category(ch) in ("Cc", "Cf", "Mn"):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def clip(text, width):
    """Recorta respetando caracteres anchos (emojis, CJK) y rellena hasta `width`."""
    out, used = [], 0
    for ch in text:
        w = char_width(ch)
        if w == 0 and unicodedata.category(ch) != "Mn":
            continue
        if used + w > width:
            break
        out.append(ch)
        used += w
    return "".join(out) + " " * max(0, width - used)


def normalize(text):
    text = unicodedata.normalize("NFKD", text.lower())
    return "".join(c for c in text if not unicodedata.combining(c))


def wrap(text, width):
    return textwrap.wrap(text, max(10, width)) if text else []


